# Public values used by the browser and the MCP server.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Set after registering the private ChatGPT OAuth client in Supabase.
SUPABASE_MCP_CLIENT_ID=

# Optional canonical production URL, for example https://baby-record.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
